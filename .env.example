# Copy to backend/.env for local (non-Docker) runs. docker-compose sets its own values.

# SQLite (default, zero setup):
#DATABASE_URL=sqlite+aiosqlite:///./data/meals.db
# Postgres via `make db`:
#DATABASE_URL=postgresql+asyncpg://meals:meals@localhost:5433/meals

REGISTRATION_ENABLED=true
SESSION_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
