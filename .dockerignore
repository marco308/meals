# The backend image builds from the repo root (docker build -f backend/Dockerfile .)
# so skill/ can ship in the image. This file also governs the deploy dir on the
# swarm manager, where .env (secrets) must never enter a build context.
.git
.env
ios
planning
deploy
# mcp/ is NOT excluded: the API mounts the MCP server at /mcp (app/mcp_mount.py)
# via a path dependency, so its source has to be in the build context.
mcp/tests
# The backup sidecar has its own build context (backup/) and nothing in it
# belongs in the API image.
backup
docker-stack.yml
backend/tests
**/__pycache__
**/.venv
**/data
**/htmlcov
**/.pytest_cache
**/.ruff_cache
**/.coverage
